pkgbase = cc-pill-kde-git
	pkgdesc = A living Plasma panel widget for Claude Code: every session at a glance, spoken briefings, hands-free ask mode
	pkgver = r0
	pkgrel = 1
	url = https://github.com/ambasoma/cc-pill
	install = cc-pill-kde-git.install
	arch = any
	license = MIT
	makedepends = git
	depends = plasma-workspace
	depends = python
	depends = tmux
	depends = jq
	depends = curl
	depends = bash
	optdepends = kdialog: the ask-mode prompt box (zenity works too)
	optdepends = gum: the setup TUI
	optdepends = playerctl: duck your music while the voice speaks
	optdepends = kdotool: stay silent when that terminal is on screen
	optdepends = pipewire-audio: voice playback through pw-play
	provides = cc-pill-kde
	conflicts = cc-pill-kde
	source = cc-pill::git+https://github.com/ambasoma/cc-pill.git#branch=linux-kde
