#!/bin/bash
# The Alfred hotkey: asks the daemon to summon Alfred. The widget sees it and
# opens the card on his box, ready to type in (or hold Space to talk).
# Bound to a global shortcut by linux/setup.sh (default Meta+Alt+M).
set -u

CFG="$HOME/.cc-pill/config.json"
PORT=$(python3 -c '
import json, sys
try:
    p = json.load(open(sys.argv[1])).get("daemon_port", 17357)
except Exception:
    p = 17357
print(p if isinstance(p, int) else 17357)' "$CFG" 2>/dev/null)
PORT="${PORT:-17357}"

if ! curl -s -m 3 -o /dev/null -f -X POST -H 'X-CC-Pill: 1' -H 'Content-Type: application/json' \
     -d '{}' "http://127.0.0.1:$PORT/alfred/summon"; then
  if command -v kdialog >/dev/null; then
    kdialog --title "cc-pill" --passivepopup "The pill daemon isn't running (systemctl --user status cc-pill)" 5
  else
    echo "cc-pill: daemon not reachable on port $PORT" >&2
  fi
  exit 1
fi
