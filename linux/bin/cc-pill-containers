#!/usr/bin/env python3
"""Wire Claude Code sessions inside LXD containers to the pill on this host.

    cc-pill-containers add web-dev play-dev   # wire these containers
    cc-pill-containers remove web-dev             # unwire one
    cc-pill-containers status

For each container this pushes the event hook to /root/.cc-pill/hook.py
(or the home of --user), writes /root/.cc-pill/remote.json with the host's
bridge address, the container's name and a token of its own, and merges the
hook into that user's ~/.claude/settings.json, keeping every hook already
there. On the host it records the bridge address and the tokens in
~/.cc-pill/config.json and restarts the daemon, which then listens on the
bridge for POST /event from exactly those containers.

Stdlib only. Needs the `lxc` client and membership of the lxd group.
"""
import argparse
import json
import os
import secrets
import shlex
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))  # through the /usr/bin symlink too
ROOT = os.path.dirname(os.path.dirname(HERE))        # the repo or /usr/share/cc-pill
sys.path.insert(0, os.path.join(ROOT, "linux", "daemon"))
import ccpilld  # noqa: E402  (no side effects at import)

HOOK_SRC = os.path.join(ROOT, "hooks", "hook.py")
DATA = ccpilld.HOME
CONFIG = ccpilld.CONFIG_PATH
LXC = ccpilld.Config.load().lxc_bin
EVENTS = {
    "SessionStart": "start", "UserPromptSubmit": "prompt", "PreToolUse": "tool",
    "Stop": "stop", "Notification": "notify", "SessionEnd": "end",
}
MARK = "/.cc-pill/hook.py"   # how our entries are recognized on re-runs and removal


def die(msg):
    print(f"cc-pill-containers: {msg}", file=sys.stderr)
    sys.exit(1)


def lxc(*args, input=None, check=True):
    p = subprocess.run([LXC, *args], input=input, capture_output=True, text=True)
    if check and p.returncode != 0:
        die(f"lxc {' '.join(args[:3])}: {(p.stderr or p.stdout).strip()}")
    return p


def sh(container, script, input=None, check=True):
    return lxc("exec", container, "--", "sh", "-c", script, input=input, check=check)


def load_config():
    try:
        with open(CONFIG) as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    """Write the config readable by this user only: it holds the tokens."""
    os.makedirs(DATA, exist_ok=True)
    tmp = CONFIG + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG)


def bridge_address(container):
    """The host's address on the network the container's default route uses.
    The container names it, so it must be one of this host's own addresses:
    the daemon listens there."""
    out = sh(container, "ip -4 route show default").stdout.split()
    if "via" not in out:
        die(f"{container}: no default route to find the host by")
    addr = out[out.index("via") + 1]
    if addr not in ccpilld.host_addresses():
        die(f"{container} routes through {addr}, which is not an address of this host; "
            "only containers on a bridge of this host (lxdbr0) can be wired")
    return addr


def merge_hooks(settings, command_for):
    """Add our hook to every event, after the hooks already there. Earlier
    copies of ours (any install path) are replaced, never duplicated."""
    settings = strip_hooks(settings)
    hooks = settings.setdefault("hooks", {})
    for event, mode in EVENTS.items():
        groups = hooks.setdefault(event, [])
        # 5 s, like setup.sh's host hooks. The two recognize their own hooks
        # differently on purpose: inside a container ours is always
        # ~/.cc-pill/hook.py (MARK); on the host it lives in the install.
        groups.append({"hooks": [{"type": "command", "command": command_for(mode), "timeout": 5}]})
    return settings


def strip_hooks(settings):
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return settings
    for event in list(hooks):
        groups = []
        for g in hooks[event] if isinstance(hooks[event], list) else []:
            inner = [h for h in g.get("hooks", []) if MARK not in str(h.get("command", ""))]
            if inner:
                groups.append(dict(g, hooks=inner))
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]
    return settings


def home_of(container, user):
    out = sh(container, f"getent passwd {shlex.quote(user)} | cut -d: -f6").stdout.strip()
    if not out:
        die(f"{container}: no user {user}")
    return out


def read_settings(container, path):
    raw = sh(container, f"cat {shlex.quote(path)} 2>/dev/null || true").stdout
    if not raw.strip():
        return {}
    try:
        data = json.loads(raw)
    except ValueError:
        die(f"{container}: {path} is not valid JSON; fix it and re-run")
    return data if isinstance(data, dict) else {}


def write_settings(container, path, settings, user):
    """Keep a backup the first time, then write through a temp file that
    takes the original's mode (settings can hold secrets) and owner."""
    body = json.dumps(settings, indent=2) + "\n"
    p, u = shlex.quote(path), shlex.quote(user)
    sh(container, f"""set -e
mkdir -p "$(dirname {p})"
if [ -e {p} ] && [ ! -e {p}.pre-cc-pill ]; then cp -p {p} {p}.pre-cc-pill; fi
(umask 077; cat > {p}.cc-pill-tmp)
if [ -e {p} ]; then chmod --reference={p} {p}.cc-pill-tmp; fi
chown {u}: {p}.cc-pill-tmp
mv {p}.cc-pill-tmp {p}""", input=body)


def add(container, user, cfg, port, home=None):
    if not os.path.exists(HOOK_SRC):
        die(f"hook not found at {HOOK_SRC}")
    if lxc("info", container, check=False).returncode != 0:
        die(f"no container named {container}")
    if sh(container, "command -v python3", check=False).returncode != 0:
        die(f"{container}: python3 is needed inside the container for the hook")
    home = home or home_of(container, user)
    host = bridge_address(container)
    cfg_host = cfg.get("bridge_host")
    if cfg_host and cfg_host != host:
        die(f"{container} reaches the host at {host}, others at {cfg_host}; one bridge only")
    cfg["bridge_host"] = host
    tokens = cfg.setdefault("containers", {})
    token = tokens.get(container) or secrets.token_urlsafe(24)
    tokens[container] = token
    # Not root: the daemon runs tmux as this uid, to reach this user's sessions.
    users = cfg.setdefault("container_users", {})
    uid = sh(container, f"id -u {shlex.quote(user)}").stdout.strip()
    if user not in ("root", "0") and uid.isdigit() and uid != "0":
        users[container] = int(uid)
    else:
        users.pop(container, None)
    if not users:
        cfg.pop("container_users", None)

    with open(HOOK_SRC) as f:
        hook = f.read()
    remote = {"url": f"http://{host}:{port}", "container": container, "token": token}
    d, u = shlex.quote(home + "/.cc-pill"), shlex.quote(user)
    sh(container, f"""set -e
mkdir -p {d}
cat > {d}/hook.py
chmod 755 {d}/hook.py
chown {u}: {d} {d}/hook.py""", input=hook)
    sh(container, f"""set -e
umask 077
cat > {d}/remote.json
chown {u}: {d}/remote.json""", input=json.dumps(remote, indent=2) + "\n")

    path = f"{home}/.claude/settings.json"
    settings = merge_hooks(read_settings(container, path),
                           lambda mode: f'python3 "{home}{MARK}" {mode}')
    write_settings(container, path, settings, user)
    print(f"  {container}: hook in {home}/.cc-pill, events to {host}:{port}")
    check_reach(container, host, port)


def check_reach(container, host, port):
    """One connection from inside the container to the bridge: a firewall
    (ufw denies incoming by default) would otherwise drop every event, and
    the pill would just stay empty."""
    probe = (f"import socket; s = socket.create_connection(({host!r}, {int(port)}), timeout=2); s.close()")
    if sh(container, f"python3 -c {shlex.quote(probe)}", check=False).returncode != 0:
        print(f"  ! {container} can't reach {host}:{port}. Is the daemon running? "
              f"With ufw: sudo ufw allow in on lxdbr0 to any port {int(port)} proto tcp")


def running(container):
    p = lxc("list", container, "--format", "csv", "-c", "ns", check=False)
    return any(l.split(",")[0] == container and l.endswith(",RUNNING") for l in p.stdout.splitlines())


def remove(container, user, cfg, home=None):
    tokens = cfg.get("containers") or {}
    tokens.pop(container, None)
    (cfg.get("container_users") or {}).pop(container, None)
    if not cfg.get("container_users"):
        cfg.pop("container_users", None)
    if not tokens:
        cfg.pop("containers", None)
        cfg.pop("bridge_host", None)
    if not running(container):
        print(f"  {container}: not running; dropped from the config (start it and remove again "
              "to take the hook out of it)")
        return
    home = home or home_of(container, user)
    path = f"{home}/.claude/settings.json"
    write_settings(container, path, strip_hooks(read_settings(container, path)), user)
    # Only our two files: ~/.cc-pill can be a whole cc-pill install.
    d = shlex.quote(home + "/.cc-pill")
    sh(container, f"rm -f {d}/hook.py {d}/remote.json; rmdir {d} 2>/dev/null || true")
    print(f"  {container}: unwired")


def restart_daemon():
    if shutil.which("systemctl") and subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", "cc-pill.service"]).returncode == 0:
        subprocess.run(["systemctl", "--user", "restart", "cc-pill.service"])
        print("  daemon restarted")
    else:
        print("  (no cc-pill.service yet: the daemon picks this up when it starts)")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("action", choices=("add", "remove", "status"))
    ap.add_argument("containers", nargs="*")
    ap.add_argument("--user", help="the user Claude Code runs as inside (default: the one it was wired "
                                   "for, or root)")
    ap.add_argument("--home", help="wire this directory instead of the user's home (tests)")
    ap.add_argument("--no-restart", action="store_true")
    a = ap.parse_args(argv)
    cfg = load_config()
    port = ccpilld.Config(cfg).port

    def user_for(c):
        """--user, else the uid this container was wired for (a re-run from
        `setup.sh update` must not rewire it as root), else root."""
        uid = (cfg.get("container_users") or {}).get(c)
        return a.user or (str(uid) if isinstance(uid, int) else "root")

    if a.action == "status":
        print(f"bridge: {cfg.get('bridge_host') or '(none)'}:{port}")
        for c in sorted(cfg.get("containers") or {}):
            if not running(c):
                print(f"  {c}: not running")
                continue
            home = sh(c, f"getent passwd {shlex.quote(user_for(c))} | cut -d: -f6", check=False).stdout.strip()
            wired = bool(home) and sh(c, f"test -e {shlex.quote(home)}/.cc-pill/remote.json",
                                      check=False).returncode == 0
            print(f"  {c}: {'wired' if wired else 'in the config, but not wired inside'}")
        return 0
    if not a.containers:
        die("name at least one container")
    for c in a.containers:
        if a.action == "add":
            add(c, user_for(c), cfg, port, a.home)
        else:
            remove(c, user_for(c), cfg, a.home)
        # After each one: a later container failing must not leave this one
        # wired with a token the host never saved.
        save_config(cfg)
    if not a.no_restart:
        restart_daemon()
    return 0


if __name__ == "__main__":
    sys.exit(main())
